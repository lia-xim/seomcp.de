---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
---

<BaseLayout
  title="Nicht gefunden"
  description="Diese Seite existiert auf seomcp.de nicht."
  canonicalPath="/404/"
>
  <div class="page-frame">
    <SiteHeader />
    <main id="main-content" class="not-found-page">
      <div>
        <strong aria-hidden="true">404</strong>
        <h1>Dieser Pfad ist nicht belegt.</h1>
        <p>Unbekannte URLs werden nicht pauschal auf die Startseite umgeleitet.</p>
        <a class="button button-primary" href="/">Zur Projektseite</a>
      </div>
    </main>
  </div>
</BaseLayout>
