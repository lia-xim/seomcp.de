---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
---

<BaseLayout routeKey="notFound">
  <div class="page-frame">
    <SiteHeader />
    <main id="main-content" class="not-found-page">
      <div>
        <strong aria-hidden="true">404</strong>
        <h1>Dieser Pfad ist nicht belegt.</h1>
        <p>Unbekannte URLs werden nicht pauschal auf die Startseite umgeleitet.</p>
        <div class="not-found-actions"><a class="button button-primary" href="/">Zur Startseite</a><a class="text-action" href="/status">Launch-Status prüfen</a></div>
      </div>
    </main>
    <SiteFooter />
  </div>
</BaseLayout>
