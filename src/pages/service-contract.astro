---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import TechnicalNav from "../components/TechnicalNav.astro";
import { evidenceState, missingServiceEvidence } from "../data/service-evidence";
---

<BaseLayout routeKey="serviceContract">
  <div class="page-frame">
    <SiteHeader />
    <main id="main-content" class="content-page">
      <div class="content-shell contract-shell">
        <header class="content-hero">
          <h1>Service-Vertrag</h1>
          <p>Es gibt derzeit keinen freigegebenen öffentlichen Crawl-Foundry-MCP-Endpunkt.</p>
          <p class="page-meta">{evidenceState}</p>
        </header>
        <div class="content-blocks">
          <section class="content-block"><h2>Vor Veröffentlichung erforderlich</h2><ul>{missingServiceEvidence.endpoint.map((item) => <li>{item}</li>)}</ul></section>
          <p class="launch-note">Bis dahin gibt es keine Verbindungs-URL, Kompatibilitäts- oder Verfügbarkeitszusage.</p>
        </div>
        <TechnicalNav />
      </div>
    </main>
    <SiteFooter />
  </div>
</BaseLayout>
