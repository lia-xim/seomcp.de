---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import TechnicalNav from "../components/TechnicalNav.astro";
import { evidenceState, missingServiceEvidence } from "../data/service-evidence";
---

<BaseLayout routeKey="capabilities">
  <div class="page-frame">
    <SiteHeader />
    <main id="main-content" class="content-page">
      <div class="content-shell contract-shell">
        <header class="content-hero">
          <h1>Capabilities</h1>
          <p>Es gibt aktuell keine veröffentlichte Liste von Tools, Ressourcen oder anderen MCP-Capabilities.</p>
          <p class="page-meta">{evidenceState}</p>
        </header>
        <div class="content-blocks">
          <section class="content-block"><h2>Vor Veröffentlichung erforderlich</h2><ul>{missingServiceEvidence.capabilities.map((item) => <li>{item}</li>)}</ul></section>
          <p class="launch-note">Dokumentiert wird nur, was mit der tatsächlich deployten Laufzeit getestet wurde.</p>
        </div>
        <TechnicalNav />
      </div>
    </main>
    <SiteFooter />
  </div>
</BaseLayout>
