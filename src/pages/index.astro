---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { site } from "../data/site";
---

<BaseLayout routeKey="home">
  <div class="page-frame">
    <SiteHeader />

    <main id="main-content">
      <section class="hero" aria-labelledby="hero-heading">
        <h1 id="hero-heading">MCP-Zugang zu Crawl Foundry.</h1>
        <p>Der öffentliche Dienst ist noch nicht gestartet. Bis dahin dokumentiert diese Seite nur die Voraussetzungen für einen sicheren Betrieb.</p>
        <div class="hero-actions">
          <a class="button" href="/status">Launch-Status</a>
          <a class="text-action" href="/security">Sicherheit</a>
        </div>
      </section>

      <section class="proof-section" id="nachweise" aria-labelledby="proof-heading">
        <h2 id="proof-heading">Vor dem Start erforderlich</h2>
        <div class="service-ledger">
          {site.plannedSurfaces.map((surface) => (
            <a class="service-row" href={surface.href}>
              <strong>{surface.host}</strong>
              <span>{surface.state}</span>
            </a>
          ))}
        </div>
      </section>

      <section class="context-line" aria-label="Produktkontext">
        <p>Technischer Zugang für <a href={site.links.contextter} rel="external noopener noreferrer">Crawl Foundry</a>. MCP-Wissen auf <a href={site.links.editorial} rel="external noopener noreferrer">seo-mcp.de</a>. Gemeinsamer Betreiber. Keine unabhängige Empfehlung.</p>
      </section>
    </main>

    <SiteFooter />
  </div>
</BaseLayout>
