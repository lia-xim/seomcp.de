---
import BaseLayout from "../layouts/BaseLayout.astro";
import ConnectionPreview from "../components/ConnectionPreview.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { site } from "../data/site";
---

<BaseLayout routeKey="home">
  <div class="page-frame">
    <SiteHeader />

    <main id="main-content">
      <section class="hero" aria-labelledby="hero-heading">
        <div class="hero-copy">
          <h1 id="hero-heading">Contextter für MCP – mit klaren Grenzen von Anfang an.</h1>
          <p>{site.purpose}</p>
          <div class="hero-actions">
            <a class="button button-primary" href="#vorhaben">Vorhaben ansehen</a>
            <a class="text-action" href={site.links.contextter} rel="external noopener noreferrer">
              Crawl Foundry entdecken
              <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M5 12h14m-5-5 5 5-5 5" /></svg>
            </a>
          </div>
        </div>
        <ConnectionPreview />
      </section>

      <section class="service-section" id="vorhaben" aria-labelledby="service-heading">
        <header class="service-intro">
          <h2 id="service-heading">Was hier entsteht</h2>
          <div>
            <p class="section-lead">Ein technischer Zugangspunkt.<br />Nicht noch ein SEO-Magazin.</p>
            <p>
              Der Dienst soll unterstützte MCP-Clients sicher mit Contextter verbinden.
              Redaktionelle Einordnung und Vergleiche bleiben bewusst auf <a href={site.links.editorial} rel="external noopener noreferrer">seo-mcp.de</a>.
            </p>
          </div>
        </header>

        <div class="service-ledger" id="contracts">
          {site.plannedSurfaces.map((surface) => (
            <a class="service-row" href={surface.href}>
              <strong>{surface.host}</strong>
              <div>
                <span>{surface.role}</span>
                <p>{surface.description}</p>
              </div>
              <small>{surface.state}</small>
            </a>
          ))}
        </div>
      </section>

      <section class="domain-section" aria-labelledby="domain-heading">
        <h2 id="domain-heading">Zwei Domains. Zwei klare Aufgaben.</h2>
        <div class="domain-grid">
          <div class="domain-column">
            <strong>seomcp.de</strong>
            <div>
              <h3>Technischer Betrieb</h3>
              <p>Hier gehören später Verbindung, Autorisierung, Sicherheit und Betriebsstatus hin.</p>
            </div>
          </div>
          <div class="domain-column domain-column-tinted">
            <strong>seo-mcp.de</strong>
            <div>
              <h3>Wissen &amp; Vergleiche</h3>
              <p>Dort gehören Implementierungshilfen, Kompatibilität und redaktionelle Bewertungen hin.</p>
            </div>
          </div>
        </div>
        <div class="ownership-bar">
          <p>Gemeinsamer Betreiber. Keine unabhängige Empfehlung.</p>
          <a href="/security">
            Sicherheitsgrundsätze ansehen
            <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M5 12h14m-5-5 5 5-5 5" /></svg>
          </a>
        </div>
      </section>

      <section class="gates-section" aria-labelledby="gates-heading">
        <header>
          <h2 id="gates-heading">Freigabe folgt Beweisen.</h2>
          <p>Ein öffentlicher Dienst wird erst angekündigt, wenn Technik, Grenzen und Betrieb geprüft sind.</p>
        </header>
        <ol class="gate-grid">
          {site.launchGates.map((gate) => (
            <li>
              <span>{gate.number}</span>
              <h3>{gate.label}</h3>
              <p>{gate.description}</p>
            </li>
          ))}
        </ol>
        <a class="text-action gates-link" href="/status">
          Vollständigen Beweisstand prüfen
          <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M5 12h14m-5-5 5 5-5 5" /></svg>
        </a>
      </section>

      <section class="contextter-band" aria-labelledby="contextter-heading">
        <div>
          <h2 id="contextter-heading">Die SEO-Plattform hinter dem Vorhaben.</h2>
          <p>Crawl Foundry verbindet Keyword-Datenbank, Site Audit und priorisierte nächste Schritte.</p>
        </div>
        <a class="band-button" href={site.links.contextter} rel="external noopener noreferrer">
          Crawl Foundry entdecken
          <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M5 12h14m-5-5 5 5-5 5" /></svg>
        </a>
      </section>
    </main>

    <SiteFooter />
  </div>
</BaseLayout>
