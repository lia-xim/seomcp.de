---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import TechnicalNav from "../components/TechnicalNav.astro";
import { site } from "../data/site";
---

<BaseLayout routeKey="security">
  <div class="page-frame">
    <SiteHeader />
    <main id="main-content" class="content-page">
      <div class="content-shell security-shell">
        <header class="content-hero">
          <h1>Sicherheit</h1>
          <p>Aktuell gibt es keinen öffentlichen MCP-Endpunkt, keine Konten und keine Uploads.</p>
        </header>

        <div class="security-content">
          <section id="meldung" aria-labelledby="report-heading">
            <h2 id="report-heading">Hinweis vertraulich melden</h2>
            <p>Bitte keine Zugangsdaten oder sensiblen Details als öffentliches Issue posten.</p>
            <p class="report-links"><a href={`mailto:${site.operator.email}`}>{site.operator.email}</a><a href={site.links.securityAdvisory} rel="external noopener noreferrer">Zum privaten Security-Advisory-Kanal</a></p>
            <p class="security-txt-link">Maschinenlesbar: <a href="/.well-known/security.txt">/.well-known/security.txt</a></p>
          </section>

          <section id="freigabe" aria-labelledby="launch-heading">
            <h2 id="launch-heading">Vor einer Freigabe</h2>
            <ul><li>Minimale Scopes und sichere Mandantentrennung.</li><li>Klare Limits und Freigaben für Kosten oder Änderungen.</li><li>Benannte Verantwortliche und ein getesteter Incident-Prozess.</li></ul>
          </section>
        </div>

        <TechnicalNav />
      </div>
    </main>
    <SiteFooter />
  </div>
</BaseLayout>
