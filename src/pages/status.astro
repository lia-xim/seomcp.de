---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import TechnicalNav from "../components/TechnicalNav.astro";
import { launchPolicy } from "../data/seo";
import { evidenceState, missingServiceEvidence } from "../data/service-evidence";
import { site } from "../data/site";

const gates = Object.values(launchPolicy.readiness);
const verifiedGates = gates.filter((gate) => gate.verified && gate.evidence).length;
---

<BaseLayout routeKey="status">
  <div class="page-frame">
    <SiteHeader />
    <main id="main-content" class="content-page">
      <div class="content-shell status-shell">
        <header class="content-hero status-hero">
          <div>
            <p class="eyebrow">Prelaunch-Readiness</p>
            <h1>Launch-Status, nicht Service-Uptime.</h1>
          </div>
          <p>Diese Seite zeigt ausschließlich, ob die belegbaren Voraussetzungen für einen öffentlichen Crawl-Foundry-MCP-Service vorliegen. Sie ist kein Uptime-Monitor, keine SLA und keine Incident-Historie.</p>
        </header>

        <section class="readiness-panel" aria-labelledby="readiness-heading">
          <div class="readiness-facts">
            <div><span>Dienst</span><strong id="readiness-heading">Noch nicht gestartet</strong></div>
            <div><span>Launch-Gates</span><strong>{verifiedGates} von {gates.length} verifiziert</strong></div>
            <div><span>Website geprüft</span><strong>{site.verifiedAt}</strong></div>
          </div>
          <ol class="readiness-rail" aria-label={`${verifiedGates} von ${gates.length} Launch-Gates verifiziert`}>
            {gates.map((gate, index) => (
              <li><span>{String(index + 1).padStart(2, "0")}</span><small>{gate.label}</small></li>
            ))}
          </ol>
        </section>

        <ol class="readiness-ledger">
          {gates.map((gate, index) => (
            <li>
              <span class="readiness-number">{String(index + 1).padStart(2, "0")}</span>
              <div>
                <div class="readiness-title"><h2>{gate.label}</h2><small><i aria-hidden="true"></i>{evidenceState}</small></div>
                <p>{gate.requirement}</p>
                <span>Kein verifizierter Beleg hinterlegt.</span>
              </div>
              <a href={gate.href}>Vertrag prüfen<svg aria-hidden="true" viewBox="0 0 24 24"><path d="m9 5 7 7-7 7" /></svg></a>
            </li>
          ))}
        </ol>

        <section class="status-evidence" id="betriebsnachweise" aria-labelledby="operations-evidence">
          <div><p class="eyebrow">Offene Betriebsbelege</p><h2 id="operations-evidence">Was für einen echten Betriebsstatus noch fehlt</h2></div>
          <ul>{missingServiceEvidence.operations.map((item) => <li>{item}</li>)}</ul>
        </section>

        <TechnicalNav />
      </div>
    </main>
    <SiteFooter />
  </div>
</BaseLayout>
