---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import TechnicalNav from "../components/TechnicalNav.astro";
import { launchPolicy } from "../data/seo";
import { evidenceState } from "../data/service-evidence";
import { site } from "../data/site";

const gates = Object.values(launchPolicy.readiness);
const verifiedGates = gates.filter((gate) => gate.verified && gate.evidence).length;
---

<BaseLayout routeKey="status">
  <div class="page-frame">
    <SiteHeader />
    <main id="main-content" class="content-page">
      <div class="content-shell status-shell">
        <header class="content-hero">
          <h1>Launch-Status</h1>
          <p>Der öffentliche MCP-Dienst ist noch nicht gestartet. Diese Seite ist kein Uptime-Monitor und keine SLA.</p>
          <p class="page-meta">{verifiedGates} von {gates.length} Voraussetzungen belegt · geprüft am {site.verifiedAt}</p>
        </header>

        <ol class="readiness-ledger">
          {gates.map((gate) => (
            <li>
              <h2><a href={gate.href}>{gate.label}</a></h2>
              <strong>{evidenceState}</strong>
              <p>{gate.requirement}</p>
            </li>
          ))}
        </ol>

        <p class="launch-note" id="betriebsnachweise">Die Indexierung bleibt bis zum belegten Service-Launch deaktiviert.</p>

        <TechnicalNav />
      </div>
    </main>
    <SiteFooter />
  </div>
</BaseLayout>
