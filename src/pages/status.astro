---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { launchPolicy } from "../data/seo";
import { evidenceState, missingServiceEvidence } from "../data/service-evidence";

const gates = Object.values(launchPolicy.readiness);
---

<BaseLayout routeKey="status">
  <div class="page-frame">
    <SiteHeader />
    <main id="main-content" class="content-page">
      <div class="content-shell contract-shell">
        <header class="content-hero contract-hero">
          <div><p class="eyebrow">Prelaunch-Gates · {evidenceState}</p><h1>Launch-Status, nicht Service-Uptime.</h1></div>
          <p>Diese Seite meldet ausschließlich, ob die Evidenz für einen öffentlichen Crawl-Foundry-MCP-Service vorliegt. Sie ist kein Uptime-Monitor, keine SLA und keine Incident-Historie.</p>
        </header>
        <div class="contract-state" role="status"><strong>{evidenceState}</strong><p>Alle vier Index- und Service-Gates sind offen. Deshalb bleiben die gesamte Website noindex und die Sitemap-Routen nicht vorhanden.</p></div>
        <ol class="status-ledger">
          {gates.map((gate, index) => <li><span>{String(index + 1).padStart(2, "0")}</span><div><strong>{evidenceState}</strong><p>{gate.requirement}</p><small>Kein verifizierter Beleg hinterlegt.</small></div></li>)}
        </ol>
        <section class="status-evidence" aria-labelledby="operations-evidence"><h2 id="operations-evidence">Was für Betriebsstatus noch fehlt</h2><ul>{missingServiceEvidence.operations.map((item) => <li>{item}</li>)}</ul></section>
        <nav class="contract-next" aria-label="Weitere technische Verträge"><a href="/service-contract">Service-Vertrag</a><a href="/capabilities">Capability-Vertrag</a><a href="/authorization">Auth-Vertrag</a><a href="/security">Sicherheit</a></nav>
      </div>
    </main>
    <SiteFooter />
  </div>
</BaseLayout>
