---
const items = [
  { number: "01", label: "Service-Vertrag", href: "/service-contract" },
  { number: "02", label: "Capabilities", href: "/capabilities" },
  { number: "03", label: "Autorisierung", href: "/authorization" },
  { number: "04", label: "Launch-Status", href: "/status" },
] as const;

const currentPath = Astro.url.pathname;
---

<nav class="technical-nav" aria-label="Technische Dokumentation">
  {items.map((item) => (
    <a href={item.href} aria-current={currentPath === item.href ? "page" : undefined}>
      <span>{item.number}</span>{item.label}
    </a>
  ))}
</nav>
