{
  "name": "seomcp-de",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Reservierte technische Projektgrundlage für einen künftigen realen SEO-MCP-Dienst.",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "pnpm seo:check && astro check && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "qa": "node scripts/qa.mjs",
    "qa:browser": "node scripts/browser-qa.mjs",
    "verify": "pnpm build && pnpm qa",
    "seo:sync": "node scripts/sync-seo-headers.mjs --write",
    "seo:check": "node scripts/sync-seo-headers.mjs --check"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.3",
    "astro": "7.2.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "playwright": "1.62.1",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@10.33.2"
}
